/* ======================== */
/* 💎 CSS 変数定義 (位置は %、サイズは vw/vh で連動) */
/* ======================== */
:root {
  /* --- 全般 --- */
  --z-index-overlay: 2147483647;
  --video-aspect-ratio: 56.25%; /* 16:9 の場合 */
  
  /* --- CTAボタン群 --- */
  --cta-right-position: 3%;         /* ★位置は % に戻す★ */
  --cta-gap: 1.0vh;                 /* サイズは vh で連動 */
  --cta-bg-color: #007bff;
  --cta-text-color: white;
  --cta-padding-y: 0.8vh;           /* サイズは vh で連動 */
  --cta-padding-x: 1.8vw;           /* サイズは vw で連動 */
  --cta-min-width: 8vw;             /* サイズは vw で連動 */
  --cta-font-size: 1.4vh;           /* ★調整: フォントサイズを 1.4vh に */
  --cta-border-radius: 5px;
  
  --cta-opacity-enabled: 1.0;
  --cta-opacity-disabled: 0.6;

  /* --- 全画面ボタン --- */
  --fs-top-position: 2%;            /* ★位置は % に戻す★ */
  --fs-right-position: 2%;          /* ★位置は % に戻す★ */
  --fs-bg-color: #ff9900;
  --fs-padding-y: 0.7vh;            /* サイズは vh で連動 */
  --fs-padding-x: 1.5vw;            /* サイズは vw で連動 */
  --fs-font-size: 1.5vh;            /* サイズは vh で連動 */

  --fs-opacity-enabled: 1.0;
}

/* ======================== */
/* 共通コンテナのスタイル */
/* ======================== */
.video-container {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  background-color: black;
}

/* ズレ解消のためのラッパー (アスペクト比制御) */
.video-wrapper {
  position: relative; 
  width: 100%;
  height: 0;
  padding-bottom: var(--video-aspect-ratio);
}

#myVideo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* ======================== */
/* 🚀 右上の全画面ボタンのスタイル */
/* ======================== */
.fullscreen-button-top-right {
  position: absolute;
  /* 位置は % でラッパーの大きさに追従 */
  top: var(--fs-top-position);       
  right: var(--fs-right-position);   
  z-index: var(--z-index-overlay);
  opacity: var(--fs-opacity-enabled); 
}

#btn-fullscreen {
  /* サイズは vw/vh で画面に連動 */
  padding: var(--fs-padding-y) var(--fs-padding-x);
  font-size: var(--fs-font-size);
  cursor: pointer;
  border: 2px solid var(--fs-bg-color);
  background-color: var(--fs-bg-color);
  color: var(--cta-text-color);
  border-radius: var(--cta-border-radius);
  transition: background-color 0.3s;
}

#btn-fullscreen:hover {
  background-color: #cc7a00;
  border-color: #cc7a00;
}

/* ======================== */
/* 縦に並ぶCTAボタンのスタイル */
/* ======================== */
.cta-buttons-overlay {
  position: absolute; 
  top: 50%;
  /* 位置は % でラッパーの大きさに追従 */
  right: var(--cta-right-position);   
  transform: translateY(-50%);
  display: flex;
  flex-direction: column; 
  gap: var(--cta-gap); /* サイズは vh で連動 */
  z-index: var(--z-index-overlay);
}

/* CTAボタン共通スタイル */
.cta-buttons-overlay button {
  /* サイズは vw/vh で画面に連動 */
  padding: var(--cta-padding-y) var(--cta-padding-x);
  font-size: var(--cta-font-size);
  cursor: pointer;
  border: 2px solid var(--cta-bg-color);
  background-color: var(--cta-bg-color);
  color: var(--cta-text-color);
  border-radius: var(--cta-border-radius);
  transition: opacity 0.3s, background-color 0.3s;
  min-width: var(--cta-min-width);
  text-align: center;
  opacity: var(--cta-opacity-enabled); 
}

/* CTA 無効時のスタイル */
.cta-buttons-overlay button:disabled {
  background-color: #ccc;
  border-color: #ccc;
  cursor: not-allowed;
  opacity: var(--cta-opacity-disabled); 
}

/* ======================== */
/* 全画面表示時のスタイル (ラッパーを中央に配置し、ズレを解消) */
/* ======================== */
/* .video-container が全画面表示のターゲット */
.video-container:fullscreen {
  width: 100%;
  height: 100%;
  max-width: none;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 全画面中、.video-wrapperを Flexアイテムとして動作させる */
.video-container:fullscreen .video-wrapper {
  position: static; 
  width: 100%;
  height: 100%;
  max-width: 100vw;
  max-height: 100vh;
  padding-bottom: 0;
  
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 全画面中、動画要素自体に object-fit: contain; を設定してアスペクト比を維持 */
.video-container:fullscreen #myVideo {
  position: relative; /* CTAボタンの基準とする */
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* 全画面表示時のボタンコンテナの位置は、親要素（.video-wrapper）に依存 */
.video-container:fullscreen .fullscreen-button-top-right,
.video-container:fullscreen .cta-buttons-overlay {
    position: absolute;
}
