/* ======================== */
/* 💎 CSS 変数定義 (位置は %、サイズは vw/vh で連動) */
/* ======================== */
:root {
  /* --- 全般 --- */
  --z-index-overlay: 2147483647;
  --video-aspect-ratio: 56.25%; /* 16:9 の場合: (9 / 16) * 100% = 56.25% */
  
  /* --- CTAボタン群 --- */
  --cta-right-position: 3%;         /* ★位置: 親要素に対する % */
  --cta-gap: 1.0vh;                 /* サイズ: vh で連動 */
  --cta-bg-color: #007bff;
  --cta-text-color: white;
  --cta-padding-y: 0.8vh;           /* サイズ: vh で連動 */
  --cta-padding-x: 1.8vw;           /* サイズ: vw で連動 */
  --cta-min-width: 8vw;             /* サイズ: vw で連動 */
  --cta-font-size: 1.4vh;           /* サイズ: vh で連動 */
  --cta-border-radius: 5px;
  
  /* ★透明度★ */
  --cta-opacity-enabled: 1.0;
  --cta-opacity-disabled: 0.6;

  /* --- 全画面ボタン --- */
  --fs-top-position: 2%;            /* ★位置: 親要素に対する % */
  --fs-right-position: 2%;          /* ★位置: 親要素に対する % */
  --fs-bg-color: #ff9900;
  --fs-padding-y: 0.7vh;            /* サイズ: vh で連動 */
  --fs-padding-x: 1.5vw;            /* サイズ: vw で連動 */
  --fs-font-size: 1.5vh;            /* サイズ: vh で連動 */

  /* ★透明度★ */
  --fs-opacity-enabled: 1.0;
}

/* ======================== */
/* 全体のリセットと body スタイル */
/* ======================== */
body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: sans-serif;
}

/* ======================== */
/* 共通コンテナのスタイル */
/* ======================== */
.video-container {
  position: relative;
  max-width: 800px;
  margin: 0 auto;
  background-color: black;
}

/* ズレ解消のためのラッパー (アスペクト比制御) */
.video-wrapper {
  position: relative; 
  width: 100%;
  height: 0;
  padding-bottom: var(--video-aspect-ratio); /* 動画の縦横比を維持 */
}

#myVideo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

/* ======================== */
/* 🚀 右上の全画面ボタンのスタイル */
/* ======================== */
.fullscreen-button-top-right {
  position: absolute;
  top: var(--fs-top-position);       
  right: var(--fs-right-position);   
  z-index: var(--z-index-overlay);
  opacity: var(--fs-opacity-enabled); 
}

#btn-fullscreen {
  padding: var(--fs-padding-y) var(--fs-padding-x);
  font-size: var(--fs-font-size);
  cursor: pointer;
  border: 2px solid var(--fs-bg-color);
  background-color: var(--fs-bg-color);
  color: var(--cta-text-color);
  border-radius: var(--cta-border-radius);
  transition: background-color 0.3s;
}

#btn-fullscreen:hover {
  background-color: #cc7a00;
  border-color: #cc7a00;
}

/* ======================== */
/* 縦に並ぶCTAボタンのスタイル */
/* ======================== */
.cta-buttons-overlay {
  position: absolute; 
  top: 50%;
  right: var(--cta-right-position);   
  transform: translateY(-50%);
  display: flex;
  flex-direction: column; 
  gap: var(--cta-gap);
  z-index: var(--z-index-overlay);
}

/* CTAボタン共通スタイル */
.cta-buttons-overlay button {
  padding: var(--cta-padding-y) var(--cta-padding-x);
  font-size: var(--cta-font-size);
  cursor: pointer;
  border: 2px solid var(--cta-bg-color);
  background-color: var(--cta-bg-color);
  color: var(--cta-text-color);
  border-radius: var(--cta-border-radius);
  transition: opacity 0.3s, background-color 0.3s;
  min-width: var(--cta-min-width);
  text-align: center;
  opacity: var(--cta-opacity-enabled); 
}

/* CTA 無効時のスタイル */
.cta-buttons-overlay button:disabled {
  background-color: #ccc;
  border-color: #ccc;
  cursor: not-allowed;
  opacity: var(--cta-opacity-disabled); 
}

/* ======================== */
/* 全画面表示時のスタイル (ズレ解消処理) */
/* ======================== */
/* .video-container が全画面表示のターゲット */
.video-container:fullscreen {
  width: 100%;
  height: 100%;
  max-width: none;
  display: flex; /* 子要素（.video-wrapper）を中央に配置 */
  justify-content: center;
  align-items: center;
}

/* 全画面中、.video-wrapperを Flexアイテムとして動作させる */
.video-container:fullscreen .video-wrapper {
  position: static; 
  width: 100%;
  height: 100%;
  max-width: 100vw;
  max-height: 100vh;
  padding-bottom: 0;
  
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 全画面中、動画要素自体に object-fit: contain; を設定してアスペクト比を維持 */
.video-container:fullscreen #myVideo {
  position: relative; /* CTAボタンの基準とする */
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* 全画面表示時のボタンコンテナの位置は、親要素（.video-wrapper）に依存 */
.video-container:fullscreen .fullscreen-button-top-right,
.video-container:fullscreen .cta-buttons-overlay {
    position: absolute;
}
